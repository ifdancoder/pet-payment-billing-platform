{
    "name": "platform/auth-contract",
    "description": "Shared signed access-token contract for the billing platform",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-sodium": "*",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Platform\\Auth\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Platform\\Auth\\Laravel\\AuthContractServiceProvider"
            ]
        }
    }
}
