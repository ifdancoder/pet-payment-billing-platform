COMPOSE_PROJECT_NAME=pet-payment-billing-platform

# Gateway
GATEWAY_HTTP_PORT=8080

# Generated locally by `make init`; never commit the resulting `.env`.
APP_KEY=
IDENTITY_APP_KEY=
CUSTOMER_APP_KEY=
CATALOG_APP_KEY=
SUBSCRIPTION_APP_KEY=
BILLING_APP_KEY=
PAYMENT_APP_KEY=
NOTIFICATION_APP_KEY=
AUTH_ED25519_PUBLIC_KEY_BASE64=
AUTH_ED25519_SECRET_KEY_BASE64=
INTERNAL_SERVICE_ACCESS_TOKEN=

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=billing
POSTGRES_PASSWORD=
POSTGRES_DB=billing

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=billing
RABBITMQ_DEFAULT_PASS=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
