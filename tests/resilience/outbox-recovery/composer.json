{
    "name": "billing-platform/resilience-outbox-recovery",
    "description": "Resilience test for outbox relay recovery.",
    "type": "project",
    "repositories": [
        {"type": "path", "url": "../../support"}
    ],
    "require": {
        "php": "^8.4.1",
        "billing-platform/test-support": "@dev",
        "guzzlehttp/guzzle": "^8.2",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "pestphp/pest": "^5.2"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "pest"
    }
}
